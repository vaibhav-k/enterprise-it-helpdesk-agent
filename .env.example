# Application

APP_NAME="Enterprise IT Helpdesk Agent"


# Authentication
#
# JWT_SECRET is required. The application will refuse to start if it
# is left blank. Generate a strong random value for every environment,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET="change-this-secret"

JWT_ALGORITHM="HS256"

JWT_EXPIRY_MINUTES=480


# Azure Storage

AZURE_STORAGE_ACCOUNT="your-storage-account"

AZURE_CONTAINER="knowledge-base"


# Azure Key Vault

KEYVAULT_NAME="enterprise-helpdesk-kv"


# Azure OpenAI
#
# AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_DEPLOYMENT are required. The
# application will refuse to start if either is left blank.

AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"

AZURE_OPENAI_DEPLOYMENT="your-deployment-name"

AZURE_OPENAI_API_VERSION="2024-10-21"

AZURE_OPENAI_TIMEOUT_SECONDS="30"

AZURE_OPENAI_MAX_TOKENS="800"


# Environment

ENVIRONMENT="development"

ENABLE_AUDIT_LOGGING=true


# Knowledge Service

KNOWLEDGE_MAX_DOCUMENTS=5

KNOWLEDGE_MAX_DOCUMENT_CHARS=12000

KNOWLEDGE_MAX_CONTEXT_CHARS=40000
