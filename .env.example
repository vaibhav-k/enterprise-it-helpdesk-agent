# Application

APP_NAME="Enterprise IT Helpdesk Agent"


# Authentication
#
# JWT_SECRET is required. The application will refuse to start if it
# is left blank. Generate a strong random value for every environment,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"

JWT_SECRET="change-this-secret"

JWT_ALGORITHM="HS256"

JWT_EXPIRY_MINUTES=480


# Azure Storage

AZURE_STORAGE_ACCOUNT="your-storage-account"

AZURE_CONTAINER="knowledge-base"


# Azure Key Vault

KEYVAULT_NAME="enterprise-helpdesk-kv"


# Azure OpenAI
#
# AZURE_OPENAI_ENDPOINT and AZURE_OPENAI_DEPLOYMENT are required. The
# application will refuse to start if either is left blank.

AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"

AZURE_OPENAI_DEPLOYMENT="your-deployment-name"

AZURE_OPENAI_API_VERSION="2024-10-21"

AZURE_OPENAI_TIMEOUT_SECONDS="30"

AZURE_OPENAI_MAX_TOKENS="800"

# Optional local-development-only fallback. Leave this unset in every
# shared or production environment: Microsoft Entra ID / managed
# identity (the default, keyless path) is the supported enterprise
# auth method. Set this ONLY if you are personally blocked on an RBAC
# grant for the "Cognitive Services OpenAI User" role and someone with
# access to the resource has given you its API key to unblock local
# testing.
AZURE_OPENAI_API_KEY=""


# Environment

ENVIRONMENT="development"

ENABLE_AUDIT_LOGGING=true


# Knowledge Service

KNOWLEDGE_MAX_DOCUMENTS=5

KNOWLEDGE_MAX_DOCUMENT_CHARS=12000

KNOWLEDGE_MAX_CONTEXT_CHARS=40000


# Azure OpenAI retry / backoff

# Transient failures (429 rate limits, 5xx, timeouts, connection
# errors) are retried with exponential backoff + jitter, honoring a
# server-supplied Retry-After header when present. Total worst-case
# attempts is 1 + AZURE_OPENAI_MAX_RETRIES.

AZURE_OPENAI_MAX_RETRIES=3

AZURE_OPENAI_RETRY_BASE_SECONDS=0.5

AZURE_OPENAI_RETRY_MAX_SECONDS=8.0


# Rate limiting

# In-memory, per-process sliding-window limits. Correct for a single
# running instance; a horizontally scaled deployment needs a shared
# store (e.g. Redis) instead, or should enforce limits at a gateway
# (e.g. Azure API Management) in front of the app.

RATE_LIMIT_LOGIN_MAX_REQUESTS=5

RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

RATE_LIMIT_CHAT_MAX_REQUESTS=20

RATE_LIMIT_CHAT_WINDOW_SECONDS=60


# Chat session persistence

# In-memory, per-process (see app/database/sessions.py). Does not
# survive a restart and is not shared across instances.

SESSION_MAX_MESSAGES=20

SESSION_MAX_PER_USER=20
